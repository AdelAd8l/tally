# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
TALLY_SECRET_KEY=

# Seed demo@tally.dev and show a "demo account" button on the sign-in page.
TALLY_DEMO=false

# Set to false after creating your own account to keep a personal server private.
TALLY_ALLOW_SIGNUP=true

# Set to true when served over HTTPS.
TALLY_COOKIE_SECURE=false

# Defaults to a local SQLite file. Postgres URLs (e.g. from Neon or Supabase) work as-is.
# TALLY_DATABASE_URL=postgresql://user:password@host/dbname
