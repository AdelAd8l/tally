# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
TALLY_SECRET_KEY=

# Seed demo@tally.dev and show a "demo account" button on the sign-in page.
TALLY_DEMO=false

# Set to true when served over HTTPS.
TALLY_COOKIE_SECURE=false

# Defaults to a local SQLite file. Any SQLAlchemy URL works.
# TALLY_DATABASE_URL=sqlite:///./tally.db
